<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ResultTaskActivity"
    android:noHistory="true"
    android:background="@color/my_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="10dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <View
            android:layout_width="300dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:gravity="center_horizontal"
            android:text="Результаты"
            android:textSize="30dp"
            android:textStyle="bold" />

        <View
            android:layout_width="250dp"
            android:layout_height="3dp"
            android:layout_marginBottom="30dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/black" />

        <TextView
            android:id="@+id/textPercentResultTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal"
            android:textSize="35dp"
            android:textStyle="bold"
            android:text="56.3%" />

        <RatingBar
            android:id="@+id/ratingBarResultTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Rating"
            android:numStars="5"
            android:isIndicator="true"
            android:theme="@style/RatingBar"
            android:alpha="1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:gravity="center_horizontal"
            android:textStyle="bold"
            android:textSize="20dp"
            android:text="Было правильно решено заданий:" />

        <TextView
            android:id="@+id/textStatisticsResultTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="60dp"
            android:gravity="center_horizontal"
            android:textStyle="bold"
            android:textSize="30dp"
            android:text="103 из 405"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:onClick="back"
            android:textSize="20dp"
            android:text="Назад" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>