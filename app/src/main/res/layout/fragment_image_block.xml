<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".fragments.ImageBlockFragment">

    <RelativeLayout
        android:id="@+id/relativeLayoutImages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="5dp"
        android:layout_marginHorizontal="5dp">

            <LinearLayout
                android:id="@+id/linearLayoutImages1"
                android:layout_width="124dp"
                android:layout_height="62dp"
                android:orientation="horizontal"
                android:background="@color/bright_green">

                <ImageView
                    android:id="@+id/imageKanji1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginVertical="5dp"
                    android:paddingHorizontal="1dp"
                    android:paddingVertical="1dp"
                    android:background="@color/black"
                    android:scaleType="fitXY"
                    tools:src="@tools:sample/avatars" />

                <ImageView
                    android:id="@+id/imageKanji2"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginVertical="5dp"
                    android:paddingHorizontal="1dp"
                    android:paddingVertical="1dp"
                    android:background="@color/black"
                    android:scaleType="fitXY"
                    tools:src="@tools:sample/avatars" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutImages2"
                android:layout_width="124dp"
                android:layout_height="62dp"
                android:orientation="horizontal"
                android:layout_below="@+id/linearLayoutImages1"
                android:background="@color/bright_green">

                <ImageView
                    android:id="@+id/imageKanji3"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginVertical="5dp"
                    android:paddingHorizontal="1dp"
                    android:paddingVertical="1dp"
                    android:background="@color/black"
                    android:scaleType="fitXY"
                    tools:src="@tools:sample/avatars" />

                <ImageView
                    android:id="@+id/imageKanji4"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginVertical="5dp"
                    android:paddingHorizontal="1dp"
                    android:paddingVertical="1dp"
                    android:background="@color/black"
                    android:scaleType="fitXY"
                    tools:src="@tools:sample/avatars" />
            </LinearLayout>

        <TextView
            android:id="@+id/textNameGroup"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linearLayoutImages2"
            android:gravity="center"
            android:textSize="20dp"
            android:text="TextView" />

    </RelativeLayout>

    <TextView
        android:id="@+id/textKanjiExistsImageBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:paddingVertical="5dp"
        android:paddingHorizontal="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/new_green"
        android:textStyle="bold"
        android:textSize="25dp"
        android:text="Имеется"/>

</FrameLayout>