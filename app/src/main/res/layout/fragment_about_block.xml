<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".fragments.AboutBlockFragment"
    android:paddingVertical="5dp"
    android:paddingHorizontal="5dp">

        <LinearLayout
            android:id="@+id/linearLayoutAboutBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="5dp"
            android:paddingHorizontal="5dp"
            android:background="@color/bright_green">

            <ImageView
                android:id="@+id/imageKanjiAboutBlock"
                android:layout_width="107dp"
                android:layout_height="107dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:layout_marginVertical="5dp"
                android:paddingHorizontal="2dp"
                android:paddingVertical="2dp"
                android:background="@color/black"
                android:scaleType="fitXY"
                tools:src="@tools:sample/avatars"/>

            <LinearLayout
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="15dp"
                android:paddingHorizontal="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Чтения"
                    android:textSize="20dp"/>

                <TextView
                    android:id="@+id/textReadingAboutBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:textSize="20dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="15dp"
                android:paddingHorizontal="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Перевод"
                    android:textSize="20dp"/>

                <TextView
                    android:id="@+id/textTranslationAboutBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="TextView"
                    android:gravity="center"
                    android:textSize="20dp"/>
            </LinearLayout>
        </LinearLayout>
</FrameLayout>